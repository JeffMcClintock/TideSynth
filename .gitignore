build/
# Also catch build-mac/, build-ios/, build-arm64/ etc. Plain "build/" did not,
# and a per-platform build tree was very nearly committed because of it.
build-*/
out/
.vs/
.vscode/
.idea/
DerivedData/
*.user
*.suo
*.sdf
*.opendb
.DS_Store
Thumbs.db
CMakeCache.txt
CMakeFiles/
compile_commands.json
node_modules/

# REAPER writes these beside a project it opens; the tests/hosts fixtures live in-repo.
tests/hosts/Backups/

# render_harness.py writes this by default; it is a machine-specific measurement.
report.json

# Python bytecode from running the scripts/ lints locally. Loading a check
# through importlib to inspect it leaves these behind, and one got committed.
__pycache__/
*.pyc
